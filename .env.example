# DOTVEX Backend Configuration
# Copy this file to .env (for local dev) or .env.production (for deployment).
# DO NOT commit the real .env file.

# ——————————————————————————————
# Server Configuration
# ——————————————————————————————

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# The URL where this application is hosted (used for callbacks/OAuth if needed).
APP_URL=http://localhost:3000

# ——————————————————————————————
# Qwen3 Model Configuration
# ——————————————————————————————

# Path to the GGUF model file. Use an absolute path on production servers.
# Do NOT commit the GGUF model file to Git.
QWEN3_MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf

# Context size (tokens) for the model. Lower = less memory, higher = more context.
QWEN3_CONTEXT_SIZE=2048

# Maximum tokens to generate per response.
QWEN3_MAX_TOKENS=4096

# Maximum time in ms to wait for model generation before timing out.
# Increase this value on slower (CPU-only) hardware.
GENERATION_TIMEOUT_MS=900000

# ——————————————————————————————
# SQLite Database Configuration
# ——————————————————————————————

# Directory for server-side persistent data (SQLite database lives here).
# Use a persistent volume path on production servers.
# Do NOT place inside a temporary filesystem (e.g. /tmp on some cloud providers).
DOTVEX_DATA_DIR=./data

# Or specify the exact database file path (overrides DOTVEX_DATA_DIR):
DATABASE_PATH=./data/dotvex.db

# Maximum memories retrieved per chat request (injected into Qwen3 context).
MEMORY_RETRIEVAL_LIMIT=5

# ——————————————————————————————
# GPU / CUDA Configuration
# ——————————————————————————————

# Enable GPU acceleration for Qwen3 inference.
# Production GPU deployments should set this to 'true'.
# Local development defaults to CPU (false).
QWEN3_GPU_ENABLED=false

# GPU type when QWEN3_GPU_ENABLED=true.
# Options: cuda, metal, vulkan
# Auto-detected if left blank (recommended for single-GPU systems).
QWEN3_GPU_TYPE=cuda

# Number of model layers to offload to GPU. Omit for maximum (all layers).
# QWEN3_GPU_LAYERS=999

# ——————————————————————————————
# Remote Inference (Kaggle GPU)
# ——————————————————————————————

# Inference mode: local (default) or remote (Kaggle GPU / cloud).
# When set to 'remote', DOTVEX sends inference requests to QWEN3_REMOTE_URL instead
# of loading the model locally via node-llama-cpp.
# QWEN3_INFERENCE_MODE=local

# URL of the remote inference server (OpenAI-compatible API).
# Set to the Kaggle Cloudflare Tunnel URL when using remote inference.
# QWEN3_REMOTE_URL=https://abc123.trycloudflare.com

# API key for the remote inference server (if required by the server).
# Generate a random key to use with llama-cpp-python server authentication.
# QWEN3_REMOTE_API_KEY=your-inference-key

# ——————————————————————————————
# Firebase Configuration
# ——————————————————————————————

# Firebase project ID (from Firebase Console → Project settings)
FIREBASE_PROJECT_ID=dotvex-ai

# Firebase Admin SDK service account key.
# OPTION A: Path to service account JSON file (recommended for local dev):
#   GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# OPTION B: Inline JSON (use for cloud deployments):
#   FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# Generate at: Firebase Console → Project settings → Service accounts → Generate new private key
# NEVER commit the actual key or .env file to Git.

# Android package name (must match your Expo app)
FIREBASE_ANDROID_PACKAGE=com.dotvex.app

# ——————————————————————————————
# API Authentication
# ——————————————————————————————

# API key for authenticating client requests via X-API-Key header.
# Generate a secure random key before deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT commit actual secrets to Git.
# When set, all /api/* requests require a valid X-API-Key header.
# Leave blank for local development (no auth).
# API_KEY=YOUR_SECRET_API_KEY_HERE

# ——————————————————————————————
# CORS Configuration
# ——————————————————————————————

# Comma-separated list of allowed origins.
# Use '*' for development only. For production, specify exact origins:
#   CORS_ORIGIN=https://your-domain.com,https://app.your-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ——————————————————————————————
# Logging Configuration
# ——————————————————————————————

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ——————————————————————————————
# Frontend Configuration (Vite)
# ——————————————————————————————

# Base URL for frontend API calls. Vite exposes VITE_ prefixed variables.
# Development: use '/api' (same-origin proxy)
# Production: use full HTTPS URL (e.g., https://api.your-domain.com)
# VITE_API_BASE_URL=/api

# API key for frontend-to-backend authentication.
# Must match the backend API_KEY. In production, set to your secure key.
# DO NOT commit actual secrets to Git.
# VITE_API_KEY=your-secure-api-key-here

# ——————————————————————————————
# Production Example (comment out the above and set these for deployment):
# ——————————————————————————————
# NODE_ENV=production
# PORT=8080
# HOST=0.0.0.0
# QWEN3_MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf
# DATABASE_PATH=/data/dotvex.db
# CORS_ORIGIN=https://your-domain.com
# QWEN3_GPU_ENABLED=true
# QWEN3_GPU_TYPE=cuda
# API_KEY=your-secure-api-key-here
# LOG_LEVEL=info
# VITE_API_BASE_URL=https://api.your-domain.com
# VITE_API_KEY=your-secure-api-key-here
#
# For Kaggle GPU inference:
# QWEN3_INFERENCE_MODE=remote
# QWEN3_REMOTE_URL=https://abc123.trycloudflare.com
# QWEN3_REMOTE_API_KEY=your-inference-key
